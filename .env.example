# DBF Fitness environment template. Copy to .env (git-ignored) for local use.
# Never put real secrets in this file. Every variable is optional for local dev:
# the app falls back to local Supabase defaults or mock adapters when unset.

# =============================================================================
# (A) PUBLIC CLIENT VARS  -  EXPO_PUBLIC_ only. Inlined into the app bundle at
#     build time, so they are visible to anyone with the app. Safe to ship.
# =============================================================================

# Supabase API URL. Local default = `supabase start`. Hosted: https://<ref>.supabase.co
# (read by src/services/supabase/client.ts and src/services/recordings/upload.ts)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase ANON (publishable) key only. Local: run `supabase status -o env` and
# copy ANON_KEY. NEVER the service_role key here.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Agora App ID (public identifier, not the certificate). Unset = local-preview
# mock video adapter (src/services/video/index.ts). Real video needs a dev client.
EXPO_PUBLIC_AGORA_APP_ID=

# Set to true to use real Expo push on a physical device (dev client / EAS build).
# Unset/false = mock push service (src/services/push/index.ts).
EXPO_PUBLIC_REAL_PUSH=false

# EAS project id used to fetch Expo push tokens (src/services/push/realPushService.ts).
# Falls back to expo-constants extra.eas.projectId. Placeholder until `eas init`.
EXPO_PUBLIC_EAS_PROJECT_ID=

# --- Legal & support URLs (REQUIRED for a store build) ---------------------
# Read by src/config/legal.ts. Each must be a LIVE, publicly reachable page
# before submission: App Store Connect and Play Console both fetch the privacy
# URL, and a 404 is an automatic rejection. Unset = the https://dbf-fitness.com
# defaults in src/config/legal.ts, which DO NOT EXIST YET (TODO_OWNER).
# Draft content for all three lives in docs/legal/.
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_URL=

# Monitored support mailbox shown on Profile and in both store listings. The
# terms promise a 24-hour response to abuse reports (Apple guideline 1.2).
EXPO_PUBLIC_SUPPORT_EMAIL=

# --- External billing link (STORE COMPLIANCE — leave unset for store builds) -
# Members pay DBF outside the app, so a "Renew now" link is payment STEERING,
# which Apple guideline 3.1.1/3.1.3 and Google Play's Payments policy forbid for
# digital services. Default (unset/false) = neutral "managed by DBF" copy with
# no purchase call to action. Entitlement is unaffected either way.
# Set to true ONLY for internal distribution that never goes through review.
# See src/components/subscription/billing.ts for the full reasoning.
EXPO_PUBLIC_ALLOW_EXTERNAL_BILLING_LINK=false

# Where "Renew" / "Subscribe" opens.
# Deliberately absent from the preview/production profiles in eas.json.
#
# !! KNOWN GAP — DO NOT SET THIS FOR ANY BUILD THAT GOES TO EITHER STORE !!
# The ALLOW_EXTERNAL_BILLING_LINK flag above is honoured ONLY by
# src/components/subscription/**. Three older surfaces read this variable
# directly and are NOT gated by the flag:
#   - src/features/liveClasses/billing.ts  (billingUrl/openBilling, ungated)
#   - src/components/live/SubscriptionBlockedPanel.tsx  ("Subscribe" CTA)
#   - src/components/live/GraceNotice.tsx               ("Renew now" CTA)
#   - src/components/coaching/SubscriptionCard.tsx      (its own billingUrl copy)
# Setting this variable therefore reinstates external-purchase steering on those
# screens regardless of the flag — exactly what Apple guideline 3.1.3 bans.
# Leaving it UNSET is what makes the current build compliant. Unifying those
# modules on src/components/subscription/billing.ts is tracked as an open item
# (those files are outside lane L1b's write set).
EXPO_PUBLIC_BILLING_URL=

# =============================================================================
# (B) SERVER-ONLY SECRETS  -  used by Supabase Edge Functions.
#     NEVER prefix with EXPO_PUBLIC_. NEVER put in the app bundle.
#     Set with:  supabase secrets set NAME=value   (hosted)
#     Local:     supabase functions serve --env-file .env   (or supabase/functions/.env)
# =============================================================================

# Agora App Certificate. With AGORA_APP_ID, agora-rtc-token mints real AccessToken2
# tokens; without them it returns mode "mock" with token null.
AGORA_APP_CERTIFICATE=

# Agora App ID as read server-side by agora-rtc-token (same value as the public one).
AGORA_APP_ID=

# Deepgram API key for ASR in transcribe-recording. Unset = deterministic mock transcript.
DEEPGRAM_API_KEY=

# Anthropic API key for the notes drafter in transcribe-recording. Unset = mock drafter.
ANTHROPIC_API_KEY=

# Service-role key: bypasses RLS. Used by live-class-reminder (callers must send it as
# Bearer) and transcribe-recording. Supabase injects it into functions automatically on
# hosted projects; only set manually for local serving with --env-file. Never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Injected by the platform into every Edge Function (listed for completeness; do not
# set by hand on hosted projects). Local values come from `supabase status -o env`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
