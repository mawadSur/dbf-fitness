# DBF Fitness environment template. Copy to .env (git-ignored) for local use.
# Never put real secrets in this file. Every variable is optional for local dev:
# the app falls back to local Supabase defaults or mock adapters when unset.

# =============================================================================
# (A) PUBLIC CLIENT VARS  -  EXPO_PUBLIC_ only. Inlined into the app bundle at
#     build time, so they are visible to anyone with the app. Safe to ship.
# =============================================================================

# Supabase API URL. Local default = `supabase start`. Hosted: https://<ref>.supabase.co
# (read by src/services/supabase/client.ts and src/services/recordings/upload.ts)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase ANON (publishable) key only. Local: run `supabase status -o env` and
# copy ANON_KEY. NEVER the service_role key here.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Agora App ID (public identifier, not the certificate). Unset = local-preview
# mock video adapter (src/services/video/index.ts). Real video needs a dev client.
EXPO_PUBLIC_AGORA_APP_ID=

# Set to true to use real Expo push on a physical device (dev client / EAS build).
# Unset/false = mock push service (src/services/push/index.ts).
EXPO_PUBLIC_REAL_PUSH=false

# EAS project id used to fetch Expo push tokens (src/services/push/realPushService.ts).
# Falls back to expo-constants extra.eas.projectId. Placeholder until `eas init`.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Where "Renew" / "Subscribe" opens (src/features/liveClasses/billing.ts).
# Unset = the app tells members to contact their coach to renew.
EXPO_PUBLIC_BILLING_URL=

# =============================================================================
# (B) SERVER-ONLY SECRETS  -  used by Supabase Edge Functions.
#     NEVER prefix with EXPO_PUBLIC_. NEVER put in the app bundle.
#     Set with:  supabase secrets set NAME=value   (hosted)
#     Local:     supabase functions serve --env-file .env   (or supabase/functions/.env)
# =============================================================================

# Agora App Certificate. With AGORA_APP_ID, agora-rtc-token mints real AccessToken2
# tokens; without them it returns mode "mock" with token null.
AGORA_APP_CERTIFICATE=

# Agora App ID as read server-side by agora-rtc-token (same value as the public one).
AGORA_APP_ID=

# Deepgram API key for ASR in transcribe-recording. Unset = deterministic mock transcript.
DEEPGRAM_API_KEY=

# Anthropic API key for the notes drafter in transcribe-recording. Unset = mock drafter.
ANTHROPIC_API_KEY=

# Service-role key: bypasses RLS. Used by live-class-reminder (callers must send it as
# Bearer) and transcribe-recording. Supabase injects it into functions automatically on
# hosted projects; only set manually for local serving with --env-file. Never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Injected by the platform into every Edge Function (listed for completeness; do not
# set by hand on hosted projects). Local values come from `supabase status -o env`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
